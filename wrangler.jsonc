{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anywherefitness",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-01",
  "observability": {
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "route": {
    "pattern": "anywherefitness.dennise.me",
    "custom_domain": true,
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "anywherefitness",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "anywherefitness",
    },
  ],
}

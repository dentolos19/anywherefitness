{
  "name": "anywherefitness",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun run types",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json --skip-build",
    "types": "wrangler types --env-file .env.template",
    "check": "oxlint --fix && oxfmt --write && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DATABASE"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^6.5.0",
    "@vinext/cloudflare": "^1.0.1",
    "drizzle-orm": "^0.45.3",
    "mapbox-gl": "^3.31.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hooks-global-state": "^2.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}

{
  "name": "anywherefitness",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun run types",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json --skip-build",
    "types": "wrangler types --env-file .env.template",
    "check": "oxlint --fix && oxfmt --write && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DATABASE"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@vinext/cloudflare": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "mapbox-gl": "^3.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hooks-global-state": "^2.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3"
  }
}

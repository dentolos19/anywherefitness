{
  "name": "anywherefitness",
  "private": true,
  "scripts": {
    "postinstall": "bun run types",
    "dev": "next dev",
    "build": "next build",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface=CloudflareEnv cloudflare-env.d.ts",
    "check": "oxlint --fix && oxfmt --write && tsc --noEmit",

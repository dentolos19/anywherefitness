    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^6.5.0",
    "@opennextjs/cloudflare": "~1.11.1",
    "drizzle-orm": "^0.45.2",
    "mapbox-gl": "^3.31.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hooks-global-state": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.55.0",
